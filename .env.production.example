# Production API Endpoint (Must be HTTPS in production)
VITE_API_BASE_URL=https://api.aicte-complaints.gov.in/api

# Disable local demonstration mock store in production
VITE_DEMO_MODE=false

# Application Display Title
VITE_APP_TITLE="AICTE Integrated Institution Complaint Monitoring System"
