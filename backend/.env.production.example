# ==============================================================================
# AICTE Integrated Dashboard - Backend Production Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env on your production host or inject into container environment.
# 2. DO NOT commit the resulting .env file containing real secrets to version control.
# 3. Ensure DATABASE_URL points to a persistent volume (e.g. /var/data/ or managed PostgreSQL).
# ==============================================================================

APP_NAME="AICTE Integrated Institution Complaint Monitoring System API"
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# Database Storage Configuration
# For Persistent SQLite (ensure directory is a mounted persistent storage volume):
DATABASE_URL=sqlite:////var/data/aicte/aicte_complaints.db
# For Enterprise PostgreSQL:
# DATABASE_URL=postgresql://aicte_user:REPLACE_WITH_STRONG_PASSWORD@db-host.internal:5432/aicte_complaints_db

# Production CORS Allowed Origins (Comma-separated HTTPS origins only)
CORS_ORIGINS=https://aicte-complaints.gov.in,https://dashboard.aicte-india.org

# Production Cryptographic Secret (Must be unique, cryptographically random, >= 32 chars)
SECRET_KEY=REPLACE_WITH_HEX_OR_BASE64_RANDOM_KEY_GENERATED_VIA_OPENSSL

# Production Security Headers & Cookie Flags
ENFORCE_HTTPS=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
