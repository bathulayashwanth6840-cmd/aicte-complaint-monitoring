# Set default behavior to automatically normalize line endings and use LF
* text=auto eol=lf

# Text file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.py text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.env* text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
*.db binary
